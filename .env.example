# Groq API — free tier, get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional — separate keys so groq/compound's small shared search budget, and
# Whisper voice transcription, don't compete with normal chat traffic. Each
# falls back to GROQ_API_KEY if left blank.
GROQ_SEARCH_API_KEY=
GROQ_VOICE_API_KEY=

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Username of the one account that can see /api/admin/* and the Admin dashboard.
# Case-insensitive. Defaults to "figobiziman" if unset.
ADMIN_USERNAME=figobiziman

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=figoai

# Server
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Google sign-in (optional) — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in (optional) — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password-reset emails via Gmail SMTP (optional) — generate an App Password at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled)
EMAIL_USER=
EMAIL_APP_PASSWORD=
