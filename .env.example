# OpenRouter — get your API key at https://openrouter.ai/keys
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_CODING_MODEL=anthropic/claude-sonnet-4
OPENROUTER_TITLE_MODEL=google/gemini-2.5-flash
 
# Groq — voice input (Whisper) and voice output (PlayAI TTS)
GROQ_VOICE_API_KEY=
GROQ_TTS_API_KEY=
GROQ_TTS_MODEL=playai-tts
GROQ_TTS_VOICE=Fritz-PlayAI

# JWT signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=365d
GUEST_JWT_EXPIRES_IN=7d

# Username of the one account that can see /api/admin/* and the Admin dashboard.
ADMIN_USERNAME=figobiziman

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=figoai

# Server
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Google sign-in — create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email notifications via Resend
RESEND_API_KEY=
